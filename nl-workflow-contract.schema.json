{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary-ai.local/schemas/nl-workflow-contract-v0.1.json",
  "title": "Binary AI Natural-Language Workflow Generation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generationId",
    "status",
    "intent",
    "registrySnapshot",
    "plan",
    "validation",
    "assumptions",
    "questions",
    "compiler"
  ],
  "properties": {
    "schemaVersion": {
      "const": "binary-ai.nl-workflow/0.1"
    },
    "generationId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "needs_clarification",
        "generated_with_warnings",
        "valid_draft",
        "blocked",
        "rejected"
      ]
    },
    "intent": {
      "$ref": "#/$defs/FlowIntent"
    },
    "registrySnapshot": {
      "$ref": "#/$defs/RegistrySnapshot"
    },
    "plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/AtomPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assumption"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "compiler": {
      "$ref": "#/$defs/CompilerMetadata"
    }
  },
  "$defs": {
    "ArtifactType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "Port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portId",
        "label",
        "schemaRef",
        "required",
        "cardinality",
        "origin"
      ],
      "properties": {
        "portId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "$ref": "#/$defs/ArtifactType"
        },
        "required": {
          "type": "boolean"
        },
        "cardinality": {
          "enum": [
            "one",
            "zero_or_one",
            "one_or_more",
            "zero_or_more"
          ]
        },
        "origin": {
          "enum": [
            "atom_default",
            "ai_proposed",
            "human_added"
          ]
        }
      }
    },
    "InputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portId",
        "label",
        "schemaRef",
        "required",
        "cardinality",
        "origin",
        "sourceKind"
      ],
      "properties": {
        "portId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "$ref": "#/$defs/ArtifactType"
        },
        "required": {
          "type": "boolean"
        },
        "cardinality": {
          "enum": [
            "one",
            "zero_or_one",
            "one_or_more",
            "zero_or_more"
          ]
        },
        "origin": {
          "enum": [
            "atom_default",
            "ai_proposed",
            "human_added"
          ]
        },
        "sourceKind": {
          "enum": [
            "upload",
            "resource_ref",
            "system_connector",
            "workflow_output",
            "user_text"
          ]
        }
      }
    },
    "OutputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portId",
        "label",
        "schemaRef",
        "required",
        "cardinality",
        "origin",
        "acceptanceSummary"
      ],
      "properties": {
        "portId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "$ref": "#/$defs/ArtifactType"
        },
        "required": {
          "type": "boolean"
        },
        "cardinality": {
          "enum": [
            "one",
            "zero_or_one",
            "one_or_more",
            "zero_or_more"
          ]
        },
        "origin": {
          "enum": [
            "atom_default",
            "ai_proposed",
            "human_added"
          ]
        },
        "acceptanceSummary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "FlowIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "businessGoal",
        "inputs",
        "outputs",
        "constraints",
        "requiredHumanDecisions",
        "sourcePromptHash"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "minLength": 1
        },
        "businessGoal": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/InputContract"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/OutputContract"
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deadline",
            "budget",
            "prohibitedActions"
          ],
          "properties": {
            "deadline": {
              "type": [
                "string",
                "null"
              ]
            },
            "budget": {
              "$ref": "#/$defs/Budget"
            },
            "prohibitedActions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "requiredHumanDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourcePromptHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "limit",
        "enforcement"
      ],
      "properties": {
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "enforcement": {
          "enum": [
            "zero_cost_only",
            "hard_limit",
            "requires_approval",
            "undefined"
          ]
        }
      }
    },
    "RegistrySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "resolvedAt",
        "actorId",
        "tenantId",
        "capabilityRegistryLayer",
        "atomVersions",
        "capabilityBindings",
        "knowledgeBases",
        "workflowVersions"
      ],
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityRegistryLayer": {
          "enum": [
            "unresolved",
            "server",
            "relay"
          ]
        },
        "atomVersions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "uniqueItems": true
        },
        "capabilityBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityBinding"
          }
        },
        "knowledgeBases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgeBaseBinding"
          }
        },
        "workflowVersions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedResourceRef"
          }
        }
      }
    },
    "VersionedResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "version"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "KnowledgeBaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "version",
        "snapshotRef",
        "accessScope"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "snapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "accessScope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CapabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "capabilityId",
        "adapterVersion",
        "environment",
        "authorized",
        "externalWrite",
        "paid",
        "bindingKind",
        "placement",
        "sideEffectClass",
        "allowedTransitiveToolIds",
        "credentialsPlatformManaged",
        "health"
      ],
      "properties": {
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "adapterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "environment": {
          "enum": [
            "test",
            "staging",
            "production"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "externalWrite": {
          "type": "boolean"
        },
        "paid": {
          "type": "boolean"
        },
        "bindingKind": {
          "enum": [
            "model",
            "skill",
            "mcp_tool",
            "connector",
            "knowledge"
          ]
        },
        "placement": {
          "enum": [
            "executor",
            "capability_node",
            "module_binding",
            "unresolved"
          ]
        },
        "sideEffectClass": {
          "enum": [
            "none",
            "read_only",
            "idempotent_write",
            "non_idempotent_write",
            "paid_submit"
          ]
        },
        "allowedTransitiveToolIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "credentialsPlatformManaged": {
          "const": true
        },
        "health": {
          "enum": [
            "healthy",
            "degraded",
            "unavailable",
            "unknown"
          ]
        }
      }
    },
    "AtomInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "atomId",
        "atomVersion",
        "templateVersion",
        "businessCategory",
        "paletteResourceGroup",
        "inputs",
        "outputs",
        "modules",
        "capabilityBindings",
        "humanReview"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "atomId": {
          "type": "string",
          "minLength": 1
        },
        "atomVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "templateVersion": {
          "const": "atom.universal@1.0.0"
        },
        "businessCategory": {
          "enum": [
            "production_material",
            "processing_agent",
            "assembly_and_freeze",
            "human_decision"
          ]
        },
        "paletteResourceGroup": {
          "enum": [
            "production_material_agent",
            "process_agent",
            "tool_or_connector",
            "human",
            "workflow"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "modules": {
          "$ref": "#/$defs/FiveModules"
        },
        "capabilityBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AtomCapabilityUse"
          }
        },
        "humanReview": {
          "$ref": "#/$defs/HumanReview"
        }
      }
    },
    "AtomCapabilityUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "bindingId",
        "required"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/ModuleName"
        },
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "ModuleName": {
      "enum": [
        "input",
        "check",
        "execute",
        "review",
        "output"
      ]
    },
    "FiveModules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "check",
        "execute",
        "review",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/ModuleSummary"
        },
        "check": {
          "$ref": "#/$defs/ModuleSummary"
        },
        "execute": {
          "$ref": "#/$defs/ModuleSummary"
        },
        "review": {
          "$ref": "#/$defs/ModuleSummary"
        },
        "output": {
          "$ref": "#/$defs/ModuleSummary"
        }
      }
    },
    "ModuleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "executorRef",
        "capabilityBindingIds",
        "outputSchema",
        "failureExits"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "executorRef": {
          "type": "string",
          "minLength": 1
        },
        "capabilityBindingIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "outputSchema": {
          "$ref": "#/$defs/ArtifactType"
        },
        "failureExits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "blocked",
              "changes_required",
              "retryable_failure",
              "unknown_outcome",
              "cancelled",
              "expired"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "HumanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reviewerBinding",
        "reviewedArtifactPort",
        "decisionOutputPort"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewerBinding": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedArtifactPort": {
          "type": [
            "string",
            "null"
          ]
        },
        "decisionOutputPort": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "from",
        "to",
        "schemaRef",
        "condition",
        "required"
      ],
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "to": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "schemaRef": {
          "$ref": "#/$defs/ArtifactType"
        },
        "condition": {
          "enum": [
            "always",
            "success",
            "changes_required",
            "unknown_outcome",
            "review_required"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "PortEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomInstanceId",
        "portId"
      ],
      "properties": {
        "atomInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "portId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "IntentCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverageId",
        "requirementKind",
        "requirementRef",
        "coveredBy",
        "validationMethod",
        "status"
      ],
      "properties": {
        "coverageId": {
          "type": "string",
          "minLength": 1
        },
        "requirementKind": {
          "enum": [
            "input",
            "output",
            "constraint",
            "human_decision"
          ]
        },
        "requirementRef": {
          "type": "string",
          "minLength": 1
        },
        "coveredBy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atomInstanceId",
              "module"
            ],
            "properties": {
              "atomInstanceId": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "$ref": "#/$defs/ModuleName"
              },
              "portId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "validationMethod": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "covered",
            "missing",
            "conflicting"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "covered",
                  "conflicting"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "coveredBy": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "coveredBy": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "AtomPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "workflowVersion",
        "revision",
        "registrySnapshotId",
        "atoms",
        "edges",
        "externalInputs",
        "workflowOutputs",
        "intentCoverage",
        "budget",
        "governance",
        "executionReadiness"
      ],
      "properties": {
        "workflowId": {
          "type": "string",
          "minLength": 1
        },
        "workflowVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "registrySnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "atoms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/AtomInstance"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "externalInputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortEndpoint"
          }
        },
        "workflowOutputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortEndpoint"
          }
        },
        "intentCoverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/IntentCoverage"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "governance": {
          "$ref": "#/$defs/Governance"
        },
        "executionReadiness": {
          "$ref": "#/$defs/ExecutionReadiness"
        }
      }
    },
    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistenceTarget",
        "lifecycleState",
        "visibility",
        "publicationApprovalRequired",
        "tokenPolicy",
        "subflowPolicy"
      ],
      "properties": {
        "persistenceTarget": {
          "enum": [
            "unresolved",
            "current_flow_architecture_v4",
            "generator_draft_store",
            "flow_2_projection"
          ]
        },
        "lifecycleState": {
          "enum": [
            "draft",
            "published",
            "retired"
          ]
        },
        "visibility": {
          "enum": [
            "owner",
            "named_users",
            "team",
            "organization",
            "marketplace"
          ]
        },
        "publicationApprovalRequired": {
          "type": "boolean"
        },
        "tokenPolicy": {
          "$ref": "#/$defs/TokenPolicy"
        },
        "subflowPolicy": {
          "$ref": "#/$defs/SubflowPolicy"
        }
      }
    },
    "TokenPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedTokens",
        "hardLimit",
        "ledgerRef",
        "payerRef",
        "accountingMode",
        "exhaustionAction"
      ],
      "properties": {
        "estimatedTokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "hardLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ledgerRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "payerRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountingMode": {
          "enum": [
            "one_row_per_model_call",
            "aggregate_run",
            "undefined"
          ]
        },
        "exhaustionAction": {
          "enum": [
            "stop",
            "wait_for_human",
            "undefined"
          ]
        }
      }
    },
    "SubflowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDepth",
        "cycleCheck",
        "subflowRefs"
      ],
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "cycleCheck": {
          "enum": [
            "passed",
            "failed",
            "not_applicable",
            "not_checked"
          ]
        },
        "subflowRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionedResourceRef"
          },
          "uniqueItems": true
        }
      }
    },
    "ExecutionReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "blockingGapIds"
      ],
      "properties": {
        "state": {
          "enum": [
            "design_only_not_runnable",
            "blocked",
            "ready_for_controlled_run"
          ]
        },
        "blockingGapIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "ValidationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueId",
        "severity",
        "code",
        "message",
        "path"
      ],
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ValidationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "executionReady",
        "binding",
        "issues",
        "layers"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "executionReady": {
          "type": "boolean"
        },
        "binding": {
          "$ref": "#/$defs/ValidationBinding"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          }
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          }
        }
      }
    },
    "ValidationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentHash",
        "planHash",
        "effectiveConfigHash",
        "validatorVersion",
        "validatedAt"
      ],
      "properties": {
        "intentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "planHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "effectiveConfigHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "validatorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "validatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumptionId",
        "statement",
        "acceptedByUser",
        "impact"
      ],
      "properties": {
        "assumptionId": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "acceptedByUser": {
          "type": "boolean"
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "question",
        "blocking",
        "reasonCode"
      ],
      "properties": {
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CompilerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilerVersion",
        "plannerMode",
        "generatedAt",
        "outputHash"
      ],
      "properties": {
        "compilerVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "plannerMode": {
          "enum": [
            "deterministic",
            "model_assisted"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
